{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:finkore:code-evidence:repositories:2.0.0",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "2.0.0"
    },
    "libraries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^CE-REPO-[0-9]{4}$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "repository": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
          },
          "github_id": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "editions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^CE-EDITION-[0-9]{4}$"
                },
                "version": {
                  "type": "string",
                  "minLength": 1
                },
                "commit_sha": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[a-f0-9]{40}$"
                },
                "observed_on": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
                },
                "reading_status": {
                  "enum": [
                    "complete",
                    "partial",
                    "not_started"
                  ]
                }
              },
              "required": [
                "id",
                "version",
                "commit_sha",
                "observed_on",
                "reading_status"
              ]
            },
            "minItems": 1
          }
        },
        "required": [
          "id",
          "name",
          "repository",
          "github_id",
          "editions"
        ]
      },
      "minItems": 1
    }
  },
  "required": [
    "schema_version",
    "libraries"
  ]
}
