{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:finkore:code-evidence:traceability:1.0.0",
  "title": "Local Code Evidence comparison curation",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "curation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "minItems": 1
        },
        "bindings": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "minItems": 1
        }
      },
      "required": [
        "description",
        "sources",
        "bindings"
      ]
    },
    "resolved": {
      "type": [
        "object",
        "null"
      ]
    }
  },
  "required": [
    "schema_version",
    "curation",
    "resolved"
  ]
}
