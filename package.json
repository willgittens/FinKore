{
  "name": "finkore",
  "version": "0.1.0",
  "private": true,
  "license": "MPL-2.0",
  "type": "module",
  "workspaces": [
    "runner",
    "implementations/typescript/core",
    "implementations/typescript/adapters/conformance"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspaces",
    "conformance:typescript": "node runner/dist/cli/cli.js --manifest conformance/manifest.json --adapter implementations/typescript/adapters/conformance/dist/adapter.js",
    "conformance:python:money": "node runner/dist/cli/cli.js --manifest conformance/manifest.json --adapter implementations/python/adapters/conformance/adapter.js --suite money",
    "conformance:python:workflow": "node runner/dist/cli/cli.js --manifest conformance/manifest.json --adapter implementations/python/adapters/conformance/adapter.js --suite workflow",
    "conformance:python:audit": "node runner/dist/cli/cli.js --manifest conformance/manifest.json --adapter implementations/python/adapters/conformance/adapter.js --suite audit",
    "conformance:python:approvals": "node runner/dist/cli/cli.js --manifest conformance/manifest.json --adapter implementations/python/adapters/conformance/adapter.js --suite approvals",
    "conformance:python:entities": "node runner/dist/cli/cli.js --manifest conformance/manifest.json --adapter implementations/python/adapters/conformance/adapter.js --suite entities",
    "conformance:python": "node runner/dist/cli/cli.js --manifest conformance/manifest.json --adapter implementations/python/adapters/conformance/adapter.js",
    "conformance:java:money": "npm run java:compile && node runner/dist/cli/cli.js --manifest conformance/manifest.json --adapter implementations/java/adapters/conformance/adapter.js --suite money",
    "python:unit": "PYTHONPATH=implementations/python/core/src .tools/bin/python3.12 -m unittest discover -s implementations/python/core/tests",
    "python:compile": "PYTHONPATH=implementations/python/core/src .tools/bin/python3.12 -m compileall -q implementations/python/core/src implementations/python/adapters/conformance implementations/python/core/tests",
    "python:coverage:setup": ".tools/bin/python3.12 -m venv .tools/python-coverage && .tools/python-coverage/bin/python -m pip install -e 'implementations/python/core[coverage]'",
    "python:coverage": "node scripts/run-python-coverage.js",
    "python:mutation:critical": "node scripts/run-critical-mutants.js python",
    "python:adapter:test": "node --test implementations/python/adapters/conformance/test/*.test.js",
    "java:compile": "node scripts/compile-java.js",
    "java:test": "npm run java:compile && node scripts/run-java-tests.js",
    "java:coverage": ".tools/bin/mvn -f implementations/java/core/pom.xml clean verify",
    "java:mutation:critical": "node scripts/run-critical-mutants.js java",
    "java:adapter:test": "npm run java:compile && node --test implementations/java/adapters/conformance/test/*.test.js",
    "mutation:critical": "node scripts/run-critical-mutants.js all",
    "portability:draft0.5": "node scripts/run-draft-0.5-portability-review.js",
    "architecture:check": "node scripts/check-implementation-boundaries.js",
    "baseline:draft0.5": "node scripts/check-draft-0.5-baseline.js",
    "tools:bootstrap:draft0.5": "node scripts/bootstrap-draft-0.5-tools.js",
    "tools:check:draft0.5": "node scripts/bootstrap-draft-0.5-tools.js --check",
    "docs:check": "node scripts/check-doc-references.js",
    "license:check": "node scripts/check-license.js"
  }
}
