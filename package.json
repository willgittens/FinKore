{
  "name": "finkore",
  "version": "0.1.0",
  "private": true,
  "license": "MPL-2.0",
  "type": "module",
  "engines": {
    "node": ">=24.11.0 <25"
  },
  "devDependencies": {
    "ajv": "^8.20.0"
  },
  "scripts": {
    "code-evidence:build": "node experts/code-evidence/tools/evidence.js --write",
    "code-evidence:check": "node experts/code-evidence/tools/evidence.js --check",
    "code-evidence:test": "node --test --test-isolation=none experts/code-evidence/tools/test/*.test.js",
    "code-evidence:library:build": "npm run code-evidence:build",
    "code-evidence:library:check": "npm run code-evidence:check",
    "code-evidence:flow:check": "npm run code-evidence:check && npm run experts:check && npm run learn:evidence:check",
    "conformance:check": "node docs/tools/validate-conformance.js",
    "agentic:check": "node docs/tools/check-agentic.js",
    "architecture:check": "node docs/tools/check-architecture.js",
    "node:check": "node docs/tools/check-node-version.js",
    "traceability:check": "node docs/tools/check-traceability.js",
    "docs:check": "node docs/tools/check-doc-links.js && node docs/tools/check-traceability.js && npm run learn:check",
    "license:check": "node docs/tools/check-license.js",
    "release:check": "node docs/tools/check-release-content.js",
    "tools:test": "node --test --test-isolation=none docs/tools/test/*.test.js",
    "dependencies:audit": "npm audit",
    "check": "npm run node:check && npm run architecture:check && npm run conformance:check && npm run agentic:check && npm run tools:test && npm run docs:check && npm run license:check && git diff --check",
    "verify": "npm run check",
    "learn:build": "node docs/tools/build-learn-evidence.js && node docs/tools/build-learn-assets.js && node docs/tools/build-learn-coredoc.js && node docs/tools/build-learn-pages.js",
    "learn:evidence:check": "node docs/tools/build-learn-evidence.js --check",
    "learn:check": "node docs/tools/build-learn-coredoc.js --check && node docs/tools/build-learn-pages.js --check",
    "experts:build": "python3 experts/tools/build_expert_traceability.py",
    "experts:check": "python3 experts/tools/build_expert_traceability.py --check",
    "experts:test": "PYTHONDONTWRITEBYTECODE=1 python3 -m unittest discover -s experts/tools/tests -v"
  }
}
