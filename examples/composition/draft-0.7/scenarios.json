        "finkore.audit.append"
      ],
      "expectedObservation": {
        "status": "success",
        "entityState": "SUBMITTED",
        "preservePriorApprovalHistory": true,
        "appendAuditEvent": true
      },
      "implementationStatus": "implemented"
    },
