    {
      "id": "entity.transition.guard-facts-pass-001",
      "spec": "entities/lifecycle",
      "requirements": ["ENTITY-LIFECYCLE-003", "ENTITY-LIFECYCLE-008", "WORKFLOW-GUARD-001", "WORKFLOW-GUARD-002", "WORKFLOW-TRANSITION-004", "WORKFLOW-TRANSITION-005", "WORKFLOW-VERSION-008"],
      "description": "Passes explicitly supplied object facts unchanged to the referenced Workflow guard and commits the target State.",
      "operation": "finkore.entity.transition",
      "input": {
        "definition": {
          "type": "invoice",
          "identityScope": "tenant-a",
          "workflow": {
            "states": ["DRAFT", "FINAL"],
            "initialState": "DRAFT",
            "terminalStates": ["FINAL"],
            "definitionIdentity": "invoice-guard-flow",
            "definitionVersionIdentity": "1",
            "transitions": [{"source": "DRAFT", "target": "FINAL", "guard": {"fact": "approvalSatisfied", "equals": true}}]
          },
          "mutability": {"DRAFT": [], "FINAL": []},
          "validation": []
        },
        "entity": {"type": "invoice", "id": "inv-guard", "state": "DRAFT", "data": {"amount": {"amount": "10", "currency": "EUR"}}, "binding": {"definitionIdentity": "invoice-guard-flow", "definitionVersionIdentity": "1"}},
        "target": "FINAL",
        "facts": {"approvalSatisfied": true}
      },
      "expected": {
        "status": "success",
        "value": {"type": "invoice", "id": "inv-guard", "state": "FINAL", "data": {"amount": {"amount": "10", "currency": "EUR"}}, "binding": {"definitionIdentity": "invoice-guard-flow", "definitionVersionIdentity": "1"}},
        "observations": {"facts": {"approvalSatisfied": true}}
      },
      "tags": ["positive", "boundary", "invariant", "mutation-sensitive"],
      "guardsAgainst": ["entity-transition-skips-workflow-guard", "entity-facts-derived-from-entity-data"],
      "pairedControl": "workflow.guard.pass-001"
    },
