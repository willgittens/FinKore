    {
      "id": "entity.import.validation-cross-field-valid-001",
      "spec": "entities/import",
      "requirements": ["ENTITY-REVISION-003", "ENTITY-REVISION-004", "ENTITY-IMPORT-002", "ENTITY-VALIDATION-001", "ENTITY-VALIDATION-003"],
      "description": "Imports an Entity whose complete amount and limit observation satisfies its declared cross-field Money validator.",
      "operation": "entity.import",
      "input": {
        "definition": {
          "type": "invoice",
          "identityScope": "tenant-a",
          "workflow": { "states": ["DRAFT"], "initialState": "DRAFT", "terminalStates": [], "transitions": [] },
          "mutability": { "DRAFT": ["amount", "limit"] },
          "validation": [{ "id": "WITHIN_LIMIT", "path": "amount", "otherPath": "limit", "rule": "money-not-greater-than" }]
        },
        "import": {
          "entity": {
            "type": "invoice",
            "id": "inv-valid-limit",
            "state": "DRAFT",
            "data": {
              "amount": { "amount": "20.00", "currency": "EUR" },
              "limit": { "amount": "20.0", "currency": "EUR" }
            }
          },
          "historicalRevisions": [{ "type": "invoice", "id": "inv-valid-limit", "revision": "legacy-r1" }]
        }
      },
      "expected": {
        "status": "success",
        "value": {
          "entity": {
            "type": "invoice",
            "id": "inv-valid-limit",
            "state": "DRAFT",
            "data": {
              "amount": { "amount": "20.00", "currency": "EUR" },
              "limit": { "amount": "20.0", "currency": "EUR" }
            }
          },
          "historicalRevisions": [{ "type": "invoice", "id": "inv-valid-limit", "revision": "legacy-r1", "current": false }]
        }
      },
      "tags": ["positive", "boundary", "regression", "mutation-sensitive"],
      "guardsAgainst": ["import-cross-field-validator-rejects-equal-money"]
    },
