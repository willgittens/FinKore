{
  "finkoreVectorFile": "0.1",
  "vectors": [
    {
      "id": "entity.import.identity-mapping-preserved-001",
      "spec": "entities/import",
      "requirements": [
        "ENTITY-IDENTITY-006",
        "ENTITY-REVISION-001",
        "ENTITY-REVISION-003",
        "ENTITY-REVISION-004",
        "ENTITY-REVISION-005",
        "ENTITY-IMPORT-001",
        "ENTITY-IMPORT-002",
        "ENTITY-IMPORT-003",
        "ENTITY-IMPORT-004",
        "ENTITY-IMPORT-005",
        "ENTITY-IMPORT-006"
      ],
      "description": "Imports an existing Entity while preserving FinKore identity, explicit source mapping, current revision, historical revision, and conflict version.",
      "operation": "entity.import",
      "input": {
        "definition": {
          "type": "invoice",
          "identityScope": "tenant-a",
          "workflow": {
            "states": ["DRAFT", "SUBMITTED", "FINAL"],
            "initialState": "DRAFT",
            "terminalStates": ["FINAL"],
            "transitions": [
              { "source": "DRAFT", "target": "SUBMITTED" },
              { "source": "SUBMITTED", "target": "FINAL" }
            ]
          },
          "mutability": {
            "DRAFT": ["amount", "memo"],
            "SUBMITTED": ["memo"],
            "FINAL": ["deliveryStatus"]
          }
        },
        "import": {
          "entity": {
            "type": "invoice",
            "id": "inv-42",
            "state": "SUBMITTED",
            "data": {
              "amount": { "amount": "100.00", "currency": "EUR" },
              "memo": "legacy import",
              "deliveryStatus": "NEW"
            }
          },
          "currentRevision": { "type": "invoice", "id": "inv-42", "revision": "business-rev-2" },
          "historicalRevisions": [{ "type": "invoice", "id": "inv-42", "revision": "business-rev-1" }],
          "sourceIdentity": { "sourceSystem": "legacy-ar", "sourceId": "LEGACY-000042" },
          "identityMapping": {
            "mappingId": "map-legacy-ar-42",
            "sourceSystem": "legacy-ar",
            "sourceId": "LEGACY-000042",
            "entity": { "type": "invoice", "id": "inv-42" }
          },
          "conflictVersion": "storage-token-9",
          "expectedState": "SUBMITTED",
          "expectedRevision": "business-rev-2",
          "expectedConflictVersion": "storage-token-9"
        }
      },
      "expected": {
        "status": "success",
        "value": {
          "entity": {
            "type": "invoice",
            "id": "inv-42",
            "state": "SUBMITTED",
            "data": {
              "amount": { "amount": "100.00", "currency": "EUR" },
              "memo": "legacy import",
              "deliveryStatus": "NEW"
            }
          },
          "currentRevision": { "type": "invoice", "id": "inv-42", "revision": "business-rev-2", "current": true },
          "historicalRevisions": [{ "type": "invoice", "id": "inv-42", "revision": "business-rev-1", "current": false }],
          "identityMapping": {
            "mappingId": "map-legacy-ar-42",
            "sourceSystem": "legacy-ar",
            "sourceId": "LEGACY-000042",
            "entity": { "type": "invoice", "id": "inv-42" }
          },
          "conflictVersion": "storage-token-9"
        }
      },
      "tags": ["positive", "invariant", "mutation-sensitive"],
      "guardsAgainst": ["source-identity-replaces-finkore-identity", "revision-history-dropped", "conflict-version-overwrites-business-revision"]
    },
    {
