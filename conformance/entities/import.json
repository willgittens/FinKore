    {
      "id": "entity.import.validation-positive-money-valid-001",
      "spec": "entities/import",
      "requirements": ["ENTITY-REVISION-003", "ENTITY-REVISION-004", "ENTITY-IMPORT-002", "ENTITY-VALIDATION-001"],
      "description": "Imports an Entity whose Money value satisfies its declared positive-money validator.",
      "operation": "entity.import",
      "input": {
        "definition": {
          "type": "invoice",
          "identityScope": "tenant-a",
          "workflow": { "states": ["DRAFT"], "initialState": "DRAFT", "terminalStates": [], "transitions": [] },
          "mutability": { "DRAFT": ["amount"] },
          "validation": [{ "id": "AMOUNT_POSITIVE", "path": "amount", "rule": "positive-money" }]
        },
        "import": {
          "entity": {
            "type": "invoice",
            "id": "inv-valid-positive",
            "state": "DRAFT",
            "data": { "amount": { "amount": "1.00", "currency": "EUR" } }
          },
          "historicalRevisions": [{ "type": "invoice", "id": "inv-valid-positive", "revision": "legacy-r1" }]
        }
      },
      "expected": {
        "status": "success",
        "value": {
          "entity": {
            "type": "invoice",
            "id": "inv-valid-positive",
            "state": "DRAFT",
            "data": { "amount": { "amount": "1.00", "currency": "EUR" } }
          },
          "historicalRevisions": [{ "type": "invoice", "id": "inv-valid-positive", "revision": "legacy-r1", "current": false }]
        }
      },
      "tags": ["positive", "regression", "mutation-sensitive"],
      "guardsAgainst": ["import-validator-rejects-every-value"]
    },
