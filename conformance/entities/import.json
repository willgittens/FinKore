            "terminalStates": [],
            "transitions": [{ "source": "DRAFT", "target": "SUBMITTED" }]
          },
          "mutability": { "DRAFT": ["amount"], "SUBMITTED": ["memo"] }
        },
        "import": {
          "entity": {
            "type": "invoice",
            "id": "inv-42",
            "state": "SUBMITTED",
            "data": { "amount": { "amount": "100.00", "currency": "EUR" } }
          },
          "sourceIdentity": { "sourceSystem": "legacy-ar", "sourceId": "LEGACY-000042" }
        }
      },
      "expected": {
        "status": "error",
        "error": { "code": "FINKORE_ENTITY_INVALID_IDENTITY" },
        "observations": {
          "entity": {
            "type": "invoice",
            "id": "inv-42",
            "state": "SUBMITTED",
            "data": { "amount": { "amount": "100.00", "currency": "EUR" } }
          }
        }
      },
      "tags": ["negative", "invariant", "mutation-sensitive"],
      "guardsAgainst": ["mapping-evidence-omitted", "sensitive-source-identity-leaked"]
    },
