    {
      "id": "entity.transition.invalid-context-null-001",
      "spec": "entities/lifecycle",
      "requirements": ["ENTITY-LIFECYCLE-009", "WORKFLOW-ERROR-008"],
      "description": "Rejects explicit null facts as malformed supplied context and preserves the complete Entity and supplied value.",
      "operation": "finkore.entity.transition",
      "input": {
        "definition": {"type": "invoice", "identityScope": "tenant-a", "workflow": {"states": ["DRAFT", "FINAL"], "initialState": "DRAFT", "terminalStates": ["FINAL"], "definitionIdentity": "context-flow", "definitionVersionIdentity": "1", "transitions": [{"source": "DRAFT", "target": "FINAL", "guard": {"fact": "approved", "equals": true}}]}, "mutability": {"DRAFT": [], "FINAL": []}, "validation": []},
        "entity": {"type": "invoice", "id": "inv-context", "state": "DRAFT", "data": {"amount": {"amount": "10", "currency": "EUR"}}, "binding": {"definitionIdentity": "context-flow", "definitionVersionIdentity": "1"}},
        "target": "FINAL",
        "facts": null
      },
      "expected": {"status": "error", "error": {"code": "FINKORE_WORKFLOW_INVALID_CONTEXT"}, "observations": {"entity": {"type": "invoice", "id": "inv-context", "state": "DRAFT", "data": {"amount": {"amount": "10", "currency": "EUR"}}, "binding": {"definitionIdentity": "context-flow", "definitionVersionIdentity": "1"}}, "facts": null}},
      "tags": ["negative", "boundary", "invariant", "mutation-sensitive"],
      "guardsAgainst": ["null-context-treated-as-omission", "invalid-context-mutates-entity"]
    },
