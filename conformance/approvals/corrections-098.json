    {
      "id": "approval.chain.sequential-pending-before-later-rejection-001",
      "spec": "approvals/chains",
      "requirements": [
        "APPROVAL-CHAIN-010"
      ],
      "description": "A later rejected Requirement does not determine a sequential Chain while its pending predecessor is the only active Requirement.",
      "operation": "approval.chain.evaluate",
      "input": {
        "chain": {
          "mode": "SEQUENTIAL",
          "requirements": [
            "manager",
            "finance"
          ],
          "rejectionOutcome": "REJECTED"
        },
        "states": {
          "manager": "PENDING",
          "finance": "REJECTED"
        }
      },
      "expected": {
        "status": "success",
        "value": {
          "state": "PENDING",
          "activeRequirements": [
            "manager"
          ]
        }
      },
      "tags": [
        "boundary",
        "regression",
        "mutation-sensitive"
      ],
      "guardsAgainst": [
        "later-rejection-bypasses-sequential-predecessor"
      ]
    },
