    {
      "id": "audit.relationship.redaction-preserves-001",
      "spec": "audit/relationships",
      "requirements": [
        "AUDIT-RELATIONSHIP-010",
        "AUDIT-RELATIONSHIP-011",
        "AUDIT-RELATIONSHIP-012"
      ],
      "description": "Preserves relationships in a redacted event representation and validates relationships on the evidence event.",
      "operation": "audit.redact",
      "input": {
        "history": [
          {
            "eventId": "evt-original",
            "eventType": "ENTITY_ISSUED",
            "entity": { "type": "invoice", "id": "inv-10" },
            "occurredAt": "2026-09-01T10:00:00Z"
          },
          {
            "eventId": "evt-correction",
            "eventType": "ENTITY_CORRECTED",
            "entity": { "type": "invoice", "id": "inv-10" },
            "occurredAt": "2026-09-01T11:00:00Z",
            "relationships": [
              {
                "relationshipId": "rel-corrects-1",
                "type": "CORRECTS",
                "target": { "eventId": "evt-original", "entity": { "type": "invoice", "id": "inv-10" } }
              }
            ],
            "changes": [
              {
                "path": "amount",
                "before": { "amount": "100.00", "currency": "USD" },
                "after": { "amount": "99.00", "currency": "USD" }
              }
            ]
          }
        ],
        "policy": {
          "id": "amount-redaction-v1",
          "protectedPaths": ["amount"],
          "authority": "retention-policy"
        },
        "redactionEvent": {
          "eventId": "evt-redaction",
          "eventType": "AUDIT_CONTENT_REDACTED",
          "entity": { "type": "invoice", "id": "inv-10" },
          "occurredAt": "2026-09-01T12:00:00Z",
          "relationships": [
            {
              "relationshipId": "rel-redaction-evidence",
              "type": "CORRECTS",
              "target": { "eventId": "evt-correction", "entity": { "type": "invoice", "id": "inv-10" } }
            }
          ]
        }
      },
      "expected": {
