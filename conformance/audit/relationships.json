          "occurredAt": "2026-09-01T11:00:00Z",
          "relationships": [
            {
              "relationshipId": "z-rel",
              "type": "SUPERSEDES",
              "target": { "eventId": "evt-source", "entity": { "type": "invoice", "id": "inv-10" } }
            },
            {
              "relationshipId": "a-rel",
              "type": "REVERSES",
              "target": { "eventId": "evt-source", "entity": { "type": "invoice", "id": "inv-10" } }
            },
            {
              "relationshipId": "m-rel",
              "type": "VOIDS",
              "target": { "eventId": "evt-source", "entity": { "type": "invoice", "id": "inv-10" } }
            }
          ]
        }
      },
      "expected": {
        "status": "success",
        "value": {
          "history": [
            {
              "eventId": "evt-source",
              "eventType": "ENTITY_ISSUED",
              "entity": { "type": "invoice", "id": "inv-10" },
              "occurredAt": "2026-09-01T10:00:00Z"
            },
            {
              "eventId": "evt-relationship-bundle",
              "eventType": "ENTITY_EVOLUTION_RECORDED",
              "entity": { "type": "invoice", "id": "inv-10" },
              "occurredAt": "2026-09-01T11:00:00Z",
              "relationships": [
                {
                  "relationshipId": "z-rel",
                  "type": "SUPERSEDES",
                  "target": { "eventId": "evt-source", "entity": { "type": "invoice", "id": "inv-10" } }
                },
                {
                  "relationshipId": "a-rel",
                  "type": "REVERSES",
                  "target": { "eventId": "evt-source", "entity": { "type": "invoice", "id": "inv-10" } }
                },
                {
                  "relationshipId": "m-rel",
                  "type": "VOIDS",
                  "target": { "eventId": "evt-source", "entity": { "type": "invoice", "id": "inv-10" } }
                }
              ]
            }
          ]
        }
      },
      "tags": ["positive", "boundary", "mutation-sensitive"],
      "guardsAgainst": ["relationship-type-rejected", "relationships-sorted-by-identity", "invented-relationship-ordering"]
    },
