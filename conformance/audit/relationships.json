              ]
            },
            {
              "eventId": "evt-redaction",
              "eventType": "AUDIT_CONTENT_REDACTED",
              "entity": { "type": "invoice", "id": "inv-10" },
              "occurredAt": "2026-09-01T12:00:00Z",
