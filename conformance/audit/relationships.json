    {
      "id": "audit.relationship.corrects.append-001",
      "spec": "audit/relationships",
      "requirements": [
        "AUDIT-RELATIONSHIP-001",
        "AUDIT-RELATIONSHIP-002",
        "AUDIT-RELATIONSHIP-003",
        "AUDIT-RELATIONSHIP-006",
        "AUDIT-RELATIONSHIP-008",
        "AUDIT-RELATIONSHIP-009"
      ],
      "description": "Appends an Audit Event carrying a CORRECTS relationship to an already committed target event.",
      "operation": "finkore.audit.append",
      "input": {
        "history": [
          {
            "eventId": "evt-original",
            "eventType": "ENTITY_ISSUED",
            "entity": { "type": "invoice", "id": "inv-10" },
            "occurredAt": "2026-09-01T10:00:00Z"
          }
        ],
        "event": {
          "eventId": "evt-correction",
          "eventType": "ENTITY_CORRECTED",
          "entity": { "type": "invoice", "id": "inv-10" },
          "occurredAt": "2026-09-01T11:00:00Z",
          "relationships": [
            {
              "relationshipId": "rel-corrects-1",
              "type": "CORRECTS",
              "target": {
                "eventId": "evt-original",
                "entity": { "type": "invoice", "id": "inv-10" }
              }
            }
          ]
        }
      },
      "expected": {
        "status": "success",
        "value": {
          "history": [
            {
              "eventId": "evt-original",
              "eventType": "ENTITY_ISSUED",
              "entity": { "type": "invoice", "id": "inv-10" },
              "occurredAt": "2026-09-01T10:00:00Z"
            },
            {
              "eventId": "evt-correction",
              "eventType": "ENTITY_CORRECTED",
              "entity": { "type": "invoice", "id": "inv-10" },
              "occurredAt": "2026-09-01T11:00:00Z",
              "relationships": [
                {
                  "relationshipId": "rel-corrects-1",
                  "type": "CORRECTS",
                  "target": {
                    "eventId": "evt-original",
                    "entity": { "type": "invoice", "id": "inv-10" }
                  }
                }
              ]
            }
          ]
        }
      },
      "tags": ["positive", "mutation-sensitive"],
      "guardsAgainst": ["relationship-dropped", "relationship-identity-rewritten", "target-entity-ignored"]
    },
    {
