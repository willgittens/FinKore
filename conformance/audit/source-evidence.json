      "requirements": ["AUDIT-REDACTION-010", "AUDIT-ERROR-001"],
      "description": "Rejects an intrinsically valid evidence Event whose semantic source linkage mismatches the request.",
      "operation": "audit.redact",
      "input": {
        "history": [{"eventId": "evt-a", "eventType": "ACCOUNT_CHANGED", "entity": {"type": "account", "id": "a"}, "occurredAt": "2026-09-01T12:00:00Z", "changes": [{"path": "bankAccount", "before": "A1", "after": "A2"}]}],
        "sourceEventId": "evt-a",
        "policy": {"id": "policy-1", "authority": "retention-policy", "protectedPaths": ["bankAccount"]},
        "redactionEvent": {"eventId": "evt-redact", "eventType": "AUDIT_CONTENT_REDACTED", "entity": {"type": "account", "id": "a"}, "occurredAt": "2026-09-02T12:00:00Z", "metadata": {"redactionEvidence": {"sourceEventId": "evt-other", "authority": "retention-policy", "protectedTargets": ["bankAccount"], "policyId": "policy-1"}}}
      },
      "expected": {"status": "error", "error": {"code": "FINKORE_AUDIT_REDACTION_INVALID"}, "observations": {"history": [{"eventId": "evt-a", "eventType": "ACCOUNT_CHANGED", "entity": {"type": "account", "id": "a"}, "occurredAt": "2026-09-01T12:00:00Z", "changes": [{"path": "bankAccount", "before": "A1", "after": "A2"}]}]}},
      "tags": ["negative", "boundary", "invariant", "mutation-sensitive"],
      "guardsAgainst": ["evidence-linkage-not-validated", "partial-evidence-append"]
    },
    {
      "id": "audit.redaction.duplicate-evidence-priority-001",
      "spec": "audit/redaction",
      "requirements": ["AUDIT-REDACTION-010", "AUDIT-ERROR-004"],
      "description": "Preserves the intrinsic duplicate-event error before semantic evidence-linkage validation.",
      "operation": "audit.redact",
      "input": {
        "history": [{"eventId": "evt-a", "eventType": "ACCOUNT_CHANGED", "entity": {"type": "account", "id": "a"}, "occurredAt": "2026-09-01T12:00:00Z", "changes": [{"path": "bankAccount", "before": "A1", "after": "A2"}]}],
        "sourceEventId": "evt-a",
        "policy": {"authority": "retention-policy", "protectedPaths": ["bankAccount"]},
        "redactionEvent": {"eventId": "evt-a", "eventType": "AUDIT_CONTENT_REDACTED", "entity": {"type": "account", "id": "wrong"}, "occurredAt": "2026-09-02T12:00:00Z", "metadata": {"redactionEvidence": {"sourceEventId": "evt-wrong", "authority": "retention-policy", "protectedTargets": ["bankAccount"]}}}
      },
