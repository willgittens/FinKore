        "evidenceEvent": {"eventId": "evt-redact-b", "eventType": "AUDIT_CONTENT_REDACTED", "entity": {"type": "account", "id": "b"}, "occurredAt": "2026-09-02T12:00:00Z", "metadata": {"redactionEvidence": {"sourceEventId": "evt-b", "authority": "retention-policy", "protectedTargets": ["bankAccount"]}}}
      }},
