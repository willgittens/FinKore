  "vectors": [
    {
      "id": "audit.redaction.explicit-source-first-001",
      "spec": "audit/redaction",
      "requirements": ["AUDIT-REDACTION-009", "AUDIT-REDACTION-010", "AUDIT-REDACTION-003", "AUDIT-REDACTION-007"],
      "description": "Selects the first of two Events containing the same protected path, preserves the unrelated Event, and appends linked evidence.",
      "operation": "audit.redact",
      "input": {
        "history": [
          {"eventId": "evt-a", "eventType": "ACCOUNT_CHANGED", "entity": {"type": "account", "id": "a"}, "actor": {"type": "user", "id": "alice"}, "occurredAt": "2026-09-01T12:00:00Z", "changes": [{"path": "bankAccount", "before": "A1", "after": "A2"}]},
          {"eventId": "evt-b", "eventType": "ACCOUNT_CHANGED", "entity": {"type": "account", "id": "b"}, "actor": {"type": "user", "id": "bob"}, "occurredAt": "2026-09-01T13:00:00Z", "changes": [{"path": "bankAccount", "before": "B1", "after": "B2"}]}
        ],
        "sourceEventId": "evt-a",
        "policy": {"id": "policy-1", "authority": "retention-policy", "protectedPaths": ["bankAccount"]},
        "redactionEvent": {"eventId": "evt-redact-a", "eventType": "AUDIT_CONTENT_REDACTED", "entity": {"type": "account", "id": "a"}, "actor": {"type": "system", "id": "retention"}, "occurredAt": "2026-09-02T12:00:00Z", "metadata": {"redactionEvidence": {"sourceEventId": "evt-a", "authority": "retention-policy", "protectedTargets": ["bankAccount"], "policyId": "policy-1"}}}
      },
      "expected": {"status": "success", "value": {
        "event": {"eventId": "evt-a", "eventType": "ACCOUNT_CHANGED", "entity": {"type": "account", "id": "a"}, "actor": {"type": "user", "id": "alice"}, "occurredAt": "2026-09-01T12:00:00Z", "changes": [{"path": "bankAccount", "before": {"presence": "REDACTED"}, "after": {"presence": "REDACTED"}}]},
        "evidenceEvent": {"eventId": "evt-redact-a", "eventType": "AUDIT_CONTENT_REDACTED", "entity": {"type": "account", "id": "a"}, "actor": {"type": "system", "id": "retention"}, "occurredAt": "2026-09-02T12:00:00Z", "metadata": {"redactionEvidence": {"sourceEventId": "evt-a", "authority": "retention-policy", "protectedTargets": ["bankAccount"], "policyId": "policy-1"}}}
      }, "observations": {"history": [
        {"eventId": "evt-a", "eventType": "ACCOUNT_CHANGED", "entity": {"type": "account", "id": "a"}, "actor": {"type": "user", "id": "alice"}, "occurredAt": "2026-09-01T12:00:00Z", "changes": [{"path": "bankAccount", "before": "A1", "after": "A2"}]},
        {"eventId": "evt-b", "eventType": "ACCOUNT_CHANGED", "entity": {"type": "account", "id": "b"}, "actor": {"type": "user", "id": "bob"}, "occurredAt": "2026-09-01T13:00:00Z", "changes": [{"path": "bankAccount", "before": "B1", "after": "B2"}]},
        {"eventId": "evt-redact-a", "eventType": "AUDIT_CONTENT_REDACTED", "entity": {"type": "account", "id": "a"}, "actor": {"type": "system", "id": "retention"}, "occurredAt": "2026-09-02T12:00:00Z", "metadata": {"redactionEvidence": {"sourceEventId": "evt-a", "authority": "retention-policy", "protectedTargets": ["bankAccount"], "policyId": "policy-1"}}}
      ]}},
      "tags": ["positive", "boundary", "invariant", "mutation-sensitive"],
      "guardsAgainst": ["matching-path-selects-arbitrary-event", "redaction-mutates-source-history", "unrelated-event-redacted"]
    },
