          {"eventId": "evt-redact-1", "eventType": "AUDIT_CONTENT_REDACTED", "entity": {"type": "account", "id": "a"}, "occurredAt": "2026-09-02T12:00:00Z", "metadata": {"redactionEvidence": {"sourceEventId": "evt-a", "authority": "retention-policy", "protectedTargets": ["bankAccount"]}}}
        ],
        "sourceEventId": "evt-a",
        "policy": {"authority": "retention-policy", "protectedPaths": ["bankAccount"]},
