    {
      "id": "money.deserialize.unknown-members-001",
      "spec": "money/serialization",
      "requirements": [
        "MONEY-CURRENCY-005",
        "MONEY-SERIALIZATION-006",
        "MONEY-SERIALIZATION-007",
        "MONEY-SERIALIZATION-008"
      ],
      "description": "Accepts unknown members without changing amount or currency meaning.",
      "operation": "money.deserialize",
      "input": {
        "value": {
          "amount": "15.50",
          "currency": "EUR",
          "minorUnitScale": 0,
          "display": "USD 999.99"
        }
      },
      "expected": {
        "status": "success",
        "value": {
          "amount": "15.5",
          "currency": "EUR"
        }
      },
      "tags": [
        "positive",
        "invariant",
        "mutation-sensitive"
      ],
      "guardsAgainst": [
        "unknown-member-semantic-override",
        "currency-metadata-as-exchange-rate"
      ]
    },
    {
      "id": "money.serialize.roundtrip-001",
      "spec": "money/serialization",
      "requirements": [
        "MONEY-SERIALIZATION-001",
        "MONEY-SERIALIZATION-002",
        "MONEY-SERIALIZATION-004",
        "MONEY-SERIALIZATION-008"
      ],
      "description": "Serialization preserves exact numeric amount and currency while the binding emits the canonical unscaled conformance observation.",
