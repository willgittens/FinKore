    {
      "id": "money.deserialize.positive-001",
      "spec": "money/serialization",
      "requirements": [
        "MONEY-REPRESENTATION-001",
        "MONEY-REPRESENTATION-002",
        "MONEY-REPRESENTATION-003",
        "MONEY-CURRENCY-001",
        "MONEY-SERIALIZATION-001",
        "MONEY-SERIALIZATION-002",
        "MONEY-SERIALIZATION-008"
      ],
      "description": "Accepts a plain exact positive decimal string with currency.",
      "operation": "money.deserialize",
      "input": {
        "value": {
          "amount": "1299.90",
          "currency": "EUR"
        }
      },
      "expected": {
        "status": "success",
        "value": {
          "amount": "1299.9",
          "currency": "EUR"
        }
      },
      "tags": [
        "positive"
      ]
    },
