      "input": {
        "value": {
          "amount": "-15.50",
          "currency": "EUR"
        }
      },
      "expected": {
        "status": "success",
        "value": {
          "amount": "-15.5",
          "currency": "EUR"
        }
      },
      "tags": [
        "positive",
        "invariant",
        "mutation-sensitive"
      ],
      "guardsAgainst": [
        "serialization-value-changed",
        "currency-omitted"
      ]
    },
