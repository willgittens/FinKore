      "id": "money.rate.decimal-exact-001",
      "spec": "money/rates",
      "requirements": [
        "MONEY-RATE-001",
        "MONEY-RATE-003",
        "MONEY-RATE-005",
        "MONEY-RATE-009"
      ],
      "description": "Applies a decimal Rate as the exact scalar and preserves currency and operand value.",
      "operation": "finkore.money.applyrate",
      "input": {
        "value": {
          "amount": "200.00",
          "currency": "USD"
        },
        "rate": {
          "kind": "DECIMAL",
          "value": "0.075"
        }
      },
      "expected": {
        "status": "success",
        "value": {
          "amount": "15",
          "currency": "USD"
        },
        "observations": {
          "operand": {
            "amount": "200.00",
            "currency": "USD"
          }
        }
