    {
      "id": "workflow.create.versioned-binding-001",
      "spec": "workflow/versioning",
      "requirements": [
        "WORKFLOW-VERSION-001",
        "WORKFLOW-VERSION-002",
        "WORKFLOW-VERSION-005",
        "WORKFLOW-VERSION-007"
      ],
      "description": "Creates a versioned instance with the supplied opaque definition identity and version identity.",
      "operation": "workflow.create",
      "input": {
        "definition": {
          "definitionIdentity": "invoice approval :: us-east",
          "definitionVersionIdentity": "v:01",
          "states": ["DRAFT", "SUBMITTED"],
          "initialState": "DRAFT",
          "terminalStates": ["SUBMITTED"],
          "transitions": [
            { "source": "DRAFT", "target": "SUBMITTED" }
          ]
        }
      },
      "expected": {
        "status": "success",
        "value": {
          "currentState": "DRAFT",
          "binding": {
            "definitionIdentity": "invoice approval :: us-east",
            "definitionVersionIdentity": "v:01"
          }
        }
      },
      "tags": ["positive", "invariant", "mutation-sensitive"],
      "guardsAgainst": ["workflow-version-identity-derived-or-normalized"]
    },
