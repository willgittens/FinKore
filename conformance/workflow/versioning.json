            { "source": "SUBMITTED", "target": "APPROVED" }
          ]
        },
        "instance": {
          "currentState": "SUBMITTED"
        }
      },
      "expected": {
        "status": "success",
        "value": { "currentState": "SUBMITTED" }
      },
      "tags": ["positive", "invariant", "mutation-sensitive"],
      "guardsAgainst": ["import-infers-initial-state"]
