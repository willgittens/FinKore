{
  "finkoreVectorFile": "0.1",
  "vectors": [
    {
      "id": "workflow.state.empty-definition-identifier-001",
      "spec": "workflow/states",
      "requirements": ["WORKFLOW-STATES-009"],
      "description": "An empty State identifier in a portable Workflow definition is invalid even when it is not the initial State.",
      "operation": "workflow.create",
      "input": {
        "definition": {
          "states": ["DRAFT", ""],
          "initialState": "DRAFT",
          "terminalStates": [],
          "transitions": []
        }
      },
      "expected": {
        "status": "error",
        "error": {"code": "FINKORE_WORKFLOW_INVALID_DEFINITION"}
      },
      "tags": ["negative", "boundary", "regression", "mutation-sensitive"],
      "guardsAgainst": ["empty-state-definition-accepted"]
    },
    {
      "id": "workflow.state.empty-current-state-001",
      "spec": "workflow/states",
      "requirements": ["WORKFLOW-STATES-009"],
      "description": "An empty current State is a malformed Workflow instance rather than an undeclared nonempty State.",
      "operation": "workflow.import",
      "input": {
        "definition": {
          "states": ["DRAFT", "SUBMITTED"],
          "initialState": "DRAFT",
          "terminalStates": ["SUBMITTED"],
          "transitions": [{"source": "DRAFT", "target": "SUBMITTED"}]
        },
        "instance": {"currentState": ""}
      },
      "expected": {
        "status": "error",
        "error": {"code": "FINKORE_WORKFLOW_INVALID_INSTANCE"}
      },
      "tags": ["negative", "invariant", "regression", "mutation-sensitive"],
      "guardsAgainst": ["empty-current-state-treated-as-undeclared"]
    },
    {
      "id": "workflow.state.empty-target-state-001",
      "spec": "workflow/states",
      "requirements": ["WORKFLOW-STATES-009"],
      "description": "An empty requested target is an invalid State and leaves the current State unchanged.",
      "operation": "finkore.workflow.transition",
      "input": {
        "definition": {
          "states": ["DRAFT", "SUBMITTED"],
          "initialState": "DRAFT",
          "terminalStates": ["SUBMITTED"],
          "transitions": [{"source": "DRAFT", "target": "SUBMITTED"}]
        },
        "instance": {"currentState": "DRAFT"},
        "target": "",
        "facts": {}
      },
      "expected": {
        "status": "error",
        "error": {"code": "FINKORE_WORKFLOW_INVALID_STATE"},
        "observations": {"currentState": "DRAFT"}
      },
      "tags": ["negative", "invariant", "regression", "mutation-sensitive"],
      "guardsAgainst": ["empty-target-treated-as-transition"]
    },
    {
      "id": "workflow.state.empty-expected-current-state-001",
      "spec": "workflow/states",
      "requirements": ["WORKFLOW-STATES-009"],
      "description": "An explicitly supplied empty expected current State is invalid input, not a conflict or an omitted precondition.",
      "operation": "finkore.workflow.transition",
      "input": {
        "definition": {
          "states": ["DRAFT", "SUBMITTED"],
          "initialState": "DRAFT",
          "terminalStates": ["SUBMITTED"],
          "transitions": [{"source": "DRAFT", "target": "SUBMITTED"}]
        },
        "instance": {"currentState": "DRAFT"},
        "target": "SUBMITTED",
        "facts": {},
        "expectedCurrentState": ""
      },
      "expected": {
        "status": "error",
        "error": {"code": "FINKORE_WORKFLOW_INVALID_STATE"},
        "observations": {"currentState": "DRAFT"}
      },
      "tags": ["negative", "invariant", "regression", "mutation-sensitive"],
      "guardsAgainst": ["empty-expected-state-treated-as-conflict"]
    }
  ]
}
