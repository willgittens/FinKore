    {
      "id": "workflow.create.initial-state-001",
      "spec": "workflow/states",
      "requirements": [
        "WORKFLOW-STATES-002",
        "WORKFLOW-STATES-003"
      ],
      "description": "Creates an instance in the one declared initial state.",
      "operation": "workflow.create",
      "input": {
        "definition": {
          "states": [
            "DRAFT",
            "SUBMITTED",
            "APPROVED",
            "REJECTED"
          ],
          "initialState": "DRAFT",
          "terminalStates": [
            "APPROVED",
            "REJECTED"
          ],
          "transitions": [
            {
              "source": "DRAFT",
              "target": "SUBMITTED"
            },
            {
              "source": "SUBMITTED",
              "target": "APPROVED",
              "guard": {
                "fact": "approvalsSatisfied",
                "equals": true
              }
            },
            {
              "source": "SUBMITTED",
              "target": "REJECTED"
            }
          ]
        }
      },
      "expected": {
        "status": "success",
        "value": {
          "currentState": "DRAFT"
        }
      },
      "tags": [
        "positive",
        "invariant"
      ]
    },
