{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://finkore.org/schemas/draft-0.6/checksums.schema.json",
  "title": "FinKore Draft 0.6 Checksum Manifest",
  "type": "object",
  "required": ["finkoreChecksums", "authority", "algorithm", "status", "generatedFor", "artifacts"],
  "properties": {
    "finkoreChecksums": { "const": "0.1" },
    "authority": { "const": "docs/draft-0.6-compatibility-claims-provenance-policy.md" },
    "algorithm": { "const": "SHA-256" },
    "status": { "const": "release-evidence-correction" },
    "generatedFor": {
      "type": "object",
      "required": [
        "coreVersion",
        "evidenceRevision",
        "supersedesEvidenceRevision",
        "sourceInventory",
        "worktreeStatus",
        "immutableTag",
        "immutableTagStatus"
      ],
      "properties": {
        "coreVersion": { "const": "draft-0.6" },
        "evidenceRevision": { "type": "string", "minLength": 1 },
        "supersedesEvidenceRevision": { "type": "string", "minLength": 1 },
        "sourceInventory": { "const": "git ls-files --cached --others --exclude-standard" },
        "worktreeStatus": { "type": "string", "minLength": 1 },
        "immutableTag": { "const": "core-draft-0.6" },
        "immutableTagStatus": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "kind", "sha256"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*\\.\\.).+"
          },
          "kind": {
            "enum": [
              "adapter",
              "agentic",
              "claim",
              "conformance",
              "documentation",
              "generated",
              "implementation",
              "license",
              "package",
              "runner",
              "schema",
              "source",
              "specification",
              "test-fixture",
              "tooling"
            ]
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "generatedBy": {
            "type": "object",
            "required": ["command", "inputs", "reproducedSha256"],
            "properties": {
              "command": { "type": "string", "minLength": 1 },
              "inputs": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "minLength": 1 }
              },
              "reproducedSha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false,
        "allOf": [
          {
            "if": { "properties": { "kind": { "const": "generated" } } },
            "then": { "required": ["generatedBy"] },
            "else": { "not": { "required": ["generatedBy"] } }
          }
        ]
      }
    }
  },
  "additionalProperties": false
}
