{
  "$schema": "../../../../node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "concurrency": 2,
  "mutate": [
    "src/money/currency.ts",
    "src/money/errors.ts",
    "src/money/money.ts",
    "src/money/serialization.ts",
    "src/workflow/definition.ts",
    "src/workflow/errors.ts",
    "src/workflow/workflow.ts",
    "src/audit/actor.ts",
    "src/audit/audit-change.ts",
    "src/audit/audit-event.ts",
    "src/audit/audit-log.ts",
    "src/audit/audit-redaction.ts",
    "src/audit/errors.ts",
    "src/entities/entity-evolution.ts",
    "src/entities/entity.ts",
    "src/entities/errors.ts",
    "src/approvals/approval-chain.ts",
    "src/approvals/approval-composition.ts",
    "src/approvals/approval-condition.ts",
    "src/approvals/approval-decision.ts",
    "src/approvals/approval-decision-history.ts",
    "src/approvals/approval-requirement.ts",
    "src/approvals/errors.ts",
    "src/portable-timestamp.ts",
    "src/approvals/approval-facts.ts",
    "src/approvals/approval-value.ts",
    "src/array-values.ts"
  ],
  "testFiles": [
    "test/**/*.test.ts"
  ],
  "reporters": [
    "clear-text",
    "html",
    "json"
  ],
  "thresholds": {
    "high": 95,
    "low": 90,
    "break": 95
  },
  "vitest": {
    "related": true
  },
  "disableTypeChecks": "src/**/*.ts"
}
