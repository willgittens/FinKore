{
  "name": "@finkore/typescript",
  "version": "0.1.0",
  "description": "Repository reference TypeScript implementation of FinKore Core 0.9 release-candidate behavior.",
  "private": true,
  "license": "MPL-2.0",
  "type": "module",
  "finkoreCore": "0.9-rc",
  "files": [
    "dist/",
    "README.md",
    "LICENSE",
    "NOTICE.md",
    "THIRD_PARTY_LICENSES.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "stryker run"
  },
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.1"
  }
}
