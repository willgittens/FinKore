    "test:mutation": "stryker run",
    "composition:test:draft0.7": "tsc -p ../examples/composition/draft-0.7/tsconfig.json && vitest run test/composition/draft-0.7-composition.test.ts"
  },
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.1"
  }
}
